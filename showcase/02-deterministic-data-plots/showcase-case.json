{
  "schema_version": "1.0",
  "id": "02-deterministic-data-plots",
  "mode": "rebuild",
  "rebuild_command": ["{python}", "{case}/sources/rebuild.py", "--repo", "{repo}", "--case", "{case}", "--output", "{output}"],
  "expected_artifacts": ["final/figure.svg", "final/figure.pdf", "final/figure.png", "provenance/data-provenance.json", "reports/qa-report.json"],
  "structural_assertions": {"svg": "final/figure.svg", "png": "final/figure.png", "pdf": "final/figure.pdf", "pdf_pages": 1, "forbid_embedded_images": true, "min_tags": {"path": 20, "text": 20}, "required_text": ["Box", "Violin", "Histogram", "Confusion", "ROC", "PR", "Asymmetric CI"], "json_status": [{"path": "reports/qa-report.json", "key": "status", "equals": "pass"}]},
  "visual_regression": {"baseline": "final/figure.png", "generated": "final/figure.png"},
  "visual_thresholds": {"max_dhash_distance": 6, "max_thumbnail_rmse": 0.035, "pixel_delta_threshold": 16, "max_changed_pixel_ratio": 0.08}
}
